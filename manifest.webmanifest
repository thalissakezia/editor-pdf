{
  "name": "Editor de PDF",
  "short_name": "Editor PDF",
  "description": "Edite textos de PDF mantendo a mesma fonte e tamanho.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f1ea",
  "theme_color": "#1d1d22",
  "icons": [
    {"src": "icones/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icones/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/pdf": [".pdf"]}}
  ]
}
